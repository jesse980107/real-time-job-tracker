{
  "website_info": {
    "name": "Lyft Careers",
    "base_url": "https://www.lyft.com/careers#openings",
    "enabled": true
  },
  "scraping_config": {
    "max_jobs": 5,
    "sleep_after_nav_ms": 1200,
    "sleep_after_open_ms": 700,

    "locations": [
      "Boston, MA",
      "Charlotte, NC",
      "Chesapeake, VA",
      "New York, NY",
      "San Francisco, CA",
      "Seattle, WA",
      "Milwaukee, WI",
      "Nashville, TN",
      "Longueuil, Canada",
      "Montreal, Canada",
      "Toronto, Canada"
    ]
  },
  "playwright_options": {
    "wait_timeout": 35000,
    "page_load_timeout": 45000,

    "results_container": "[data-testid='core-ui-layout-container']",
    "card_anchor_selector": "a[target='_blank'][href*='app.careerpuck.com/job-board/lyft/job']",

    "detail_title": "h1:has-text(','), h1",
    "detail_location": "[data-testing*='Location'] h3, [class*='Location'] h3, [data-testing*='Location']",
    "detail_req_id": "[data-testing*='Requisition'] div, [class*='Requisition'] div",
    "detail_description": "[data-testing='job-description'], [data-testing*='job-description']",
    "detail_time": "time[datetime], [data-testing*='Posted'] time, [data-testing*='posted'] time"
  }
}
