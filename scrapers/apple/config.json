{
    "website_info": {
        "name": "Apple Careers",
        "base_url": "https://jobs.apple.com/en-us/search",
        "enabled": true
    },
    "scraping_config": {
        "max_jobs": 45,
        "sleep_after_nav_ms": 1000,
        "sleep_after_open_ms": 500,
        "apply_filters_via_ui": false,
        "locations": [
            "United States",
            "Canada"
        ]
    },
    "playwright_options": {
        "results_link_selector": "a[href*='/details/']",
        "show_more_button": "button:has-text('Next'), [aria-label*='next' i], .pagination-next",
        "detail_title": "h1",
        "detail_description": ".jd-info, .job-description, main section",
        "job_card_selector": "h3 a[href*='/details/'], .searchresult-container a[href*='/details/']",
        "see_details_button": "a[href*='/details/']",
        "pagination_button": ".pagination-next, button:has-text('Next')",
        "job_summary_selector": ".jd-info section, .summary-section",
        "job_qualifications_selector": ".qualifications-section, section:has(h2:has-text('Qualifications'))"
    }
}